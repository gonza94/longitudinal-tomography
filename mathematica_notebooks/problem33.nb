Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"ContourPlot", "[", 
    RowBox[{
     RowBox[{"Evaluate", "[", 
      RowBox[{"H", "[", 
       RowBox[{"pPhi", ",", "phi", ",", "psiS", ",", "1"}], "]"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"phi", ",", 
       RowBox[{
        RowBox[{"-", "2"}], " ", "Pi"}], ",", 
       RowBox[{"2", " ", "Pi"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"pPhi", ",", 
       RowBox[{"-", "3"}], ",", "3"}], "}"}], ",", 
     RowBox[{"Contours", "->", "30"}], ",", 
     RowBox[{"ContourShading", "->", "True"}], ",", 
     RowBox[{"FrameLabel", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Style", "[", 
         RowBox[{"\"\<\[Phi]\>\"", ",", "15"}], "]"}], ",", 
        RowBox[{"Style", "[", 
         RowBox[{
          RowBox[{"Subscript", "[", 
           RowBox[{"\"\<p\>\"", ",", "\"\<\[Phi]\>\""}], "]"}], ",", "15"}], 
         "]"}]}], "}"}]}], ",", 
     RowBox[{"PlotLabel", "->", 
      RowBox[{"Row", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Subscript", "[", 
          RowBox[{"\"\<\[Psi]\>\"", ",", "\"\<s\>\""}], "]"}], ",", 
         "\"\< = \>\"", ",", 
         RowBox[{"NumberForm", "[", 
          RowBox[{"psiS", ",", 
           RowBox[{"{", 
            RowBox[{"4", ",", "2"}], "}"}]}], "]"}]}], "}"}], "]"}]}], ",", 
     RowBox[{"PlotPoints", "->", "80"}], ",", 
     RowBox[{"MaxRecursion", "->", "2"}], ",", 
     RowBox[{"AspectRatio", "->", "0.3"}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"psiS", ",", "Pi", ",", 
       RowBox[{"Subscript", "[", 
        RowBox[{"\"\<\[Psi]\>\"", ",", "\"\<s\>\""}], "]"}]}], "}"}], ",", 
     RowBox[{
      RowBox[{"Pi", "/", "2"}], "+", "0.05"}], ",", 
     RowBox[{
      RowBox[{"3", " ", 
       RowBox[{"Pi", "/", "2"}]}], "-", "0.05"}]}], "}"}]}], "]"}]], "Input",
