Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"H", ",", "pPhi", ",", "phi", ",", "psiS", ",", "Omega"}], "]"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"H", "[", 
    RowBox[{"pPhi_", ",", "phi_", ",", "psiS_", ",", "Omega_"}], "]"}], ":=", 
   
   RowBox[{
    RowBox[{
     RowBox[{"pPhi", "^", "2"}], "/", "2"}], "+", 
    RowBox[{
     RowBox[{
      RowBox[{"Omega", "^", "2"}], "/", 
      RowBox[{"Cos", "[", "psiS", "]"}]}], "*", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Cos", "[", 
        RowBox[{"psiS", "+", "phi"}], "]"}], "-", 
       RowBox[{"Cos", "[", "psiS", "]"}], "+", 
       RowBox[{"phi", "*", 
        RowBox[{"Sin", "[", "psiS", "]"}]}]}], ")"}]}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.993114076290514*^9, 3.993114076295439*^9}, {
  3.9932475183759623`*^9, 3.993247518775856*^9}},
 CellLabel->"In[2]:=",ExpressionUUID->"05cfcbca-c741-4d8e-8d4d-300bd1cd03b0"],

