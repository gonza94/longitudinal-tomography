         2 ArcSin[$CellContext`k 
            JacobiSN[$CellContext`z0 + $CellContext`tau, $CellContext`k^2]]], \
$CellContext`z0[
         PatternTest[
          Pattern[$CellContext`theta0, 
           Blank[]], NumericQ], 
         PatternTest[
