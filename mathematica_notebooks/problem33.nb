      "Options" :> {
       ControlPlacement -> Left, 
        TrackedSymbols :> {$CellContext`theta0$$, $CellContext`p0$$, \
$CellContext`nPeriods$$}}, "DefaultOptions" :> {}],
     ImageSizeCache->{1032., {529., 535.}},
     SingleEvaluation->True],
    Deinitialization:>None,
    DynamicModuleValues:>{},
    Initialization:>({$CellContext`pendulumSolution[
         PatternTest[
          Pattern[$CellContext`theta0, 
           Blank[]], NumericQ], 
         PatternTest[
          Pattern[$CellContext`p0, 
           Blank[]], NumericQ], 
         Optional[
          Pattern[$CellContext`tau0, 
           Blank[]], 0]] := 
       Module[{$CellContext`energyValue, $CellContext`thetaWrapped, \
$CellContext`thetaShift, $CellContext`sigma, $CellContext`tolerance = 
          10^(-10), $CellContext`k, $CellContext`kr, $CellContext`kappa, \
$CellContext`sn0, $CellContext`cn0, $CellContext`u0, $CellContext`z0, \
$CellContext`crossingTime}, $CellContext`energyValue = $CellContext`p0^2/2 - 
           Cos[$CellContext`theta0]; $CellContext`thetaWrapped = 
          Mod[$CellContext`theta0 + Pi, 2 Pi] - 
           Pi; $CellContext`thetaShift = $CellContext`theta0 - \
$CellContext`thetaWrapped; $CellContext`sigma = 
          If[$CellContext`p0 >= 0, 1, -1]; 
         Which[$CellContext`energyValue < 
           1 - $CellContext`tolerance, $CellContext`k = 
            Sqrt[(1 + $CellContext`energyValue)/2]; $CellContext`sn0 = 
            Sin[$CellContext`thetaWrapped/
               2]/$CellContext`k; $CellContext`cn0 = $CellContext`p0/(
             2 $CellContext`k); $CellContext`u0 = 
            ArcTan[$CellContext`cn0, $CellContext`sn0]; $CellContext`z0 = 
            EllipticF[$CellContext`u0, $CellContext`k^2]; 
           With[{$CellContext`kk = $CellContext`k, $CellContext`zz0 = \
$CellContext`z0, $CellContext`shift = $CellContext`thetaShift, $CellContext`e = \
$CellContext`energyValue, $CellContext`tInitial = $CellContext`tau0}, <|
             "Motion" -> "Libration", "Energy" -> $CellContext`e, 
              "Modulus" -> $CellContext`kk, "Period" -> 
              4 EllipticK[$CellContext`kk^2], "Theta" -> 
              Function[{$CellContext`tau}, $CellContext`shift + 
                2 ArcSin[$CellContext`kk 
                   JacobiSN[$CellContext`zz0 + $CellContext`tau - \
$CellContext`tInitial, $CellContext`kk^2]]], "Momentum" -> 
              Function[{$CellContext`tau}, 2 $CellContext`kk 
                JacobiCN[$CellContext`zz0 + $CellContext`tau - \
$CellContext`tInitial, $CellContext`kk^2]]|>], $CellContext`energyValue > 
           1 + $CellContext`tolerance, $CellContext`kappa = 
            Sqrt[($CellContext`energyValue + 1)/2]; $CellContext`kr = 
            1/$CellContext`kappa; $CellContext`z0 = 
            EllipticF[$CellContext`thetaWrapped/2, $CellContext`kr^2]; 
           With[{$CellContext`kap = $CellContext`kappa, \
$CellContext`reciprocalK = $CellContext`kr, $CellContext`zz0 = \
$CellContext`z0, $CellContext`direction = $CellContext`sigma, \
$CellContext`shift = $CellContext`thetaShift, $CellContext`e = \
$CellContext`energyValue, $CellContext`tInitial = $CellContext`tau0}, <|
             "Motion" -> "Rotation", "Energy" -> $CellContext`e, 
              "Modulus" -> $CellContext`reciprocalK, "Period" -> 
              2 (EllipticK[$CellContext`reciprocalK^2]/$CellContext`kap), 
              "Theta" -> Function[{$CellContext`tau}, $CellContext`shift + 
                2 JacobiAmplitude[$CellContext`zz0 + $CellContext`direction \
$CellContext`kap ($CellContext`tau - $CellContext`tInitial), \
$CellContext`reciprocalK^2]], "Momentum" -> 
              Function[{$CellContext`tau}, 
                2 $CellContext`direction $CellContext`kap 
                JacobiDN[$CellContext`zz0 + $CellContext`direction \
$CellContext`kap ($CellContext`tau - $CellContext`tInitial), \
$CellContext`reciprocalK^2]]|>], True, 
           If[
            And[
            Abs[$CellContext`p0] < $CellContext`tolerance, 
             Abs[Abs[$CellContext`thetaWrapped] - Pi] < 10^(-8)], 
            
            With[{$CellContext`thetaFixed = $CellContext`theta0, \
$CellContext`e = $CellContext`energyValue}, <|
             "Motion" -> "Unstable fixed point", "Energy" -> $CellContext`e, 
              "Modulus" -> 1, "Period" -> Infinity, "Theta" -> 
              Function[{$CellContext`tau}, $CellContext`thetaFixed], 
              "Momentum" -> 
              Function[{$CellContext`tau}, 
                0]|>], $CellContext`crossingTime = $CellContext`tau0 - \
$CellContext`sigma Log[
                Tan[(Pi + $CellContext`thetaWrapped)/4]]; 
            With[{$CellContext`direction = $CellContext`sigma, \
$CellContext`tc = $CellContext`crossingTime, $CellContext`shift = \
$CellContext`thetaShift, $CellContext`e = $CellContext`energyValue}, <|
              "Motion" -> "Separatrix", "Energy" -> $CellContext`e, "Modulus" -> 
               1, "Period" -> Infinity, "Theta" -> 
               Function[{$CellContext`tau}, $CellContext`shift + 4 ArcTan[
                    
                    Exp[$CellContext`direction ($CellContext`tau - \
$CellContext`tc)]] - Pi], "Momentum" -> 
               Function[{$CellContext`tau}, 2 $CellContext`direction 
                 Sech[$CellContext`tau - $CellContext`tc]]|>]]]], \
$CellContext`u0[
         PatternTest[
          Pattern[$CellContext`theta0, 
           Blank[]], NumericQ], 
         PatternTest[
          Pattern[$CellContext`p0, 
           Blank[]], NumericQ]] := 
       Module[{$CellContext`k}, $CellContext`k = \
$CellContext`kModulus[$CellContext`theta0, $CellContext`p0]; 
         ArcSin[Sin[$CellContext`theta0/
             2]/$CellContext`k]], $CellContext`kModulus[
         PatternTest[
          Pattern[$CellContext`theta0, 
           Blank[]], NumericQ], 
         PatternTest[
          Pattern[$CellContext`p0, 
           Blank[]], NumericQ]] := 
       Sqrt[(1 + $CellContext`energy[$CellContext`theta0, $CellContext`p0])/
         2], $CellContext`energy[
         PatternTest[
          Pattern[$CellContext`theta0, 
           Blank[]], NumericQ], 
         PatternTest[
          Pattern[$CellContext`p0, 
           Blank[]], NumericQ]] := $CellContext`p0^2/2 - 
        Cos[$CellContext`theta0], $CellContext`z0[
         PatternTest[
          Pattern[$CellContext`theta0, 
           Blank[]], NumericQ], 
         PatternTest[
          Pattern[$CellContext`p0, 
           Blank[]], NumericQ]] := 
       Module[{$CellContext`k}, $CellContext`k = \
$CellContext`kModulus[$CellContext`theta0, $CellContext`p0]; EllipticF[
           $CellContext`u0[$CellContext`theta0, $CellContext`p0], \
$CellContext`k^2]]}; Typeset`initDone$$ = True),
    SynchronousInitialization->True,
    UndoTrackedVariables:>{Typeset`show$$, Typeset`bookmarkMode$$},
