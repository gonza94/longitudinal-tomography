         PatternTest[
          Pattern[$CellContext`p0, 
           Blank[]], NumericQ]] := $CellContext`p0^2/2 - 
        Cos[$CellContext`theta0], $CellContext`thetaExact[
         PatternTest[
          Pattern[$CellContext`tau, 
           Blank[]], NumericQ], 
