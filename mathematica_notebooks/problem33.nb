Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "energy", ",", "kModulus", ",", "initialArgument", ",", "thetaExact", ",",
      "pExact"}], "]"}], ";"}], "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{"Hamiltonian", " ", "energy"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"energy", "[", 
     RowBox[{
      RowBox[{"theta0_", "?", "NumericQ"}], ",", 
      RowBox[{"p0_", "?", "NumericQ"}]}], "]"}], ":=", 
    RowBox[{
     RowBox[{
      RowBox[{"p0", "^", "2"}], "/", "2"}], "-", 
     RowBox[{"Cos", "[", "theta0", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
  "\n", 
  RowBox[{"(*", 
   RowBox[{"Elliptic", " ", "modulus", " ", "k"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"kModulus", "[", 
     RowBox[{
      RowBox[{"theta0_", "?", "NumericQ"}], ",", 
      RowBox[{"p0_", "?", "NumericQ"}]}], "]"}], ":=", 
    RowBox[{"Sqrt", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{"energy", "[", 
         RowBox[{"theta0", ",", "p0"}], "]"}]}], ")"}], "/", "2"}], "]"}]}], 
   ";"}], "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
   "Initial", " ", "argument", " ", "of", " ", "the", " ", "Jacobi", " ", 
    "elliptic", " ", "functions"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"initialArgument", "[", 
    RowBox[{
     RowBox[{"theta0_", "?", "NumericQ"}], ",", 
     RowBox[{"p0_", "?", "NumericQ"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"k", ",", "sn0", ",", "cn0", ",", "u0"}], "}"}], ",", 
     RowBox[{
      RowBox[{"k", "=", 
       RowBox[{"kModulus", "[", 
        RowBox[{"theta0", ",", "p0"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"sn0", "=", 
       RowBox[{"Clip", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Sin", "[", 
           RowBox[{"theta0", "/", "2"}], "]"}], "/", "k"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"cn0", "=", 
       RowBox[{"Clip", "[", 
        RowBox[{
         RowBox[{"p0", "/", 
          RowBox[{"(", 
           RowBox[{"2", " ", "k"}], ")"}]}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "Selects", " ", "the", " ", "correct", " ", "quadrant", " ", "using", 
        " ", "both", " ", "theta0", " ", "and", " ", "p0"}], "*)"}], 
      RowBox[{"u0", "=", 
       RowBox[{"ArcTan", "[", 
        RowBox[{"cn0", ",", "sn0"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Mathematica", " ", "uses", " ", 
        RowBox[{"k", "^", "2"}], " ", "as", " ", "its", " ", "elliptic", " ", 
        "parameter"}], "*)"}], 
      RowBox[{"EllipticF", "[", 
       RowBox[{"u0", ",", 
        RowBox[{"k", "^", "2"}]}], "]"}]}]}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.993326799589375*^9, 3.993326799596245*^9}},
 CellLabel->"In[31]:=",ExpressionUUID->"94626fe5-3a77-4d5e-8fb7-93dc33b40953"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"thetaExact", "[", 
     RowBox[{
      RowBox[{"tau_", "?", "NumericQ"}], ",", 
      RowBox[{"theta0_", "?", "NumericQ"}], ",", 
      RowBox[{"p0_", "?", "NumericQ"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"k", ",", "z0"}], "}"}], ",", 
      RowBox[{
       RowBox[{"k", "=", 
        RowBox[{"kModulus", "[", 
         RowBox[{"theta0", ",", "p0"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"z0", "=", 
        RowBox[{"initialArgument", "[", 
         RowBox[{"theta0", ",", "p0"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"2", " ", 
        RowBox[{"ArcSin", "[", 
         RowBox[{"k", " ", 
          RowBox[{"JacobiSN", "[", 
           RowBox[{
            RowBox[{"z0", "+", "tau"}], ",", 
            RowBox[{"k", "^", "2"}]}], "]"}]}], "]"}]}]}]}], "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"pExact", "[", 
    RowBox[{
     RowBox[{"tau_", "?", "NumericQ"}], ",", 
     RowBox[{"theta0_", "?", "NumericQ"}], ",", 
     RowBox[{"p0_", "?", "NumericQ"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"k", ",", "z0"}], "}"}], ",", 
     RowBox[{
      RowBox[{"k", "=", 
       RowBox[{"kModulus", "[", 
        RowBox[{"theta0", ",", "p0"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"z0", "=", 
       RowBox[{"initialArgument", "[", 
        RowBox[{"theta0", ",", "p0"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"2", " ", "k", " ", 
       RowBox[{"JacobiCN", "[", 
        RowBox[{
         RowBox[{"z0", "+", "tau"}], ",", 
         RowBox[{"k", "^", "2"}]}], "]"}]}]}]}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.993326812569564*^9, 3.993326812575697*^9}},
