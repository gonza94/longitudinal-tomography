    Typeset`update$$ = 0, Typeset`initDone$$, Typeset`skipInitDone$$ = False}, 
    DynamicBox[Manipulate`ManipulateBoxes[
     1, StandardForm, 
      "Variables" :> {$CellContext`nPeriods$$ = 3, $CellContext`p0$$ = 
        0.5, $CellContext`theta0$$ = 0.7}, "ControllerVariables" :> {}, 
      "OtherVariables" :> {
       Typeset`show$$, Typeset`bookmarkList$$, Typeset`bookmarkMode$$, 
        Typeset`animator$$, Typeset`animvar$$, Typeset`name$$, 
        Typeset`specs$$, Typeset`size$$, Typeset`update$$, Typeset`initDone$$,
         Typeset`skipInitDone$$}, "Body" :> 
      Module[{$CellContext`solution$, $CellContext`energyValue$, \
$CellContext`motionType$, $CellContext`characteristicTime$, \
$CellContext`timeMaximum$, $CellContext`timePlot$, $CellContext`phasePlot$, \
$CellContext`separatrixPlot$}, $CellContext`solution$ = \
$CellContext`pendulumSolution[$CellContext`theta0$$, $CellContext`p0$$]; \
$CellContext`energyValue$ = $CellContext`solution$[
          "Energy"]; $CellContext`motionType$ = $CellContext`solution$[
          "Motion"]; $CellContext`characteristicTime$ = If[
           And[
            NumericQ[
             $CellContext`solution$["Period"]], $CellContext`solution$[
             "Period"] =!= Infinity], 
           $CellContext`solution$["Period"], 
           10]; $CellContext`timeMaximum$ = $CellContext`nPeriods$$ \
$CellContext`characteristicTime$; $CellContext`timePlot$ = Plot[{
            $CellContext`solution$["Theta"][$CellContext`tau], 
            $CellContext`solution$[
            "Momentum"][$CellContext`tau]}, {$CellContext`tau, 
            0, $CellContext`timeMaximum$}, Frame -> True, FrameLabel -> {
             Style["\[Tau]", 14], 
             Style["\[Theta](\[Tau]), P(\[Tau])", 14]}, 
           PlotLegends -> {"\[Theta](\[Tau])", "P(\[Tau])"}, PlotRange -> All,
            ImageSize -> Large]; $CellContext`separatrixPlot$ = 
         Plot[{2 Cos[$CellContext`theta/2], (-2) 
            Cos[$CellContext`theta/2]}, {$CellContext`theta, -Pi, Pi}, 
           PlotStyle -> {
             Directive[Gray, Dashed], 
             Directive[Gray, Dashed]}]; $CellContext`phasePlot$ = 
         Show[$CellContext`separatrixPlot$, 
           
           ParametricPlot[{
            Mod[$CellContext`solution$["Theta"][$CellContext`tau] + Pi, 2 Pi] - 
             Pi, 
             $CellContext`solution$[
             "Momentum"][$CellContext`tau]}, {$CellContext`tau, 
             0, $CellContext`timeMaximum$}, PlotStyle -> Thick, PlotPoints -> 
            150], 
           Graphics[{
             PointSize[0.022], 
             
             Point[{Mod[$CellContext`theta0$$ + Pi, 2 Pi] - 
               Pi, $CellContext`p0$$}]}], Frame -> True, FrameLabel -> {
             Style["\[Theta]", 14], 
             Style["P", 14]}, PlotRange -> {{-Pi, Pi}, {-3.5, 3.5}}, 
           AspectRatio -> 1, ImageSize -> Large]; Column[{
           Grid[{{
              Style["Energy", Bold], 
              NumberForm[$CellContext`energyValue$, {7, 4}], 
              Spacer[20], 
              Style["Motion", Bold], $CellContext`motionType$}, {
              Style["Initial phase", Bold], 
              NumberForm[$CellContext`theta0$$, {6, 3}], 
              Spacer[20], 
              Style["Initial momentum", Bold], 
              NumberForm[$CellContext`p0$$, {6, 3}]}, {
              Style["Period", Bold], 
              If[$CellContext`solution$["Period"] === Infinity, "\[Infinity]", 
               NumberForm[
                $CellContext`solution$["Period"], {8, 4}]], 
              Spacer[20], 
              Style["Modulus", Bold], 
              NumberForm[
               $CellContext`solution$["Modulus"], {7, 
               4}]}}], $CellContext`timePlot$, $CellContext`phasePlot$}]], 
