Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "pendulumSolution", "]"}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"pendulumSolution", "[", 
    RowBox[{
     RowBox[{"theta0_", "?", "NumericQ"}], ",", 
     RowBox[{"p0_", "?", "NumericQ"}], ",", 
     RowBox[{"tau0_", ":", "0"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "energyValue", ",", "thetaWrapped", ",", "thetaShift", ",", "sigma", 
       ",", 
       RowBox[{"tolerance", "=", 
        RowBox[{"10", "^", 
         RowBox[{"-", "10"}]}]}], ",", "k", ",", "kr", ",", "kappa", ",", 
       "sn0", ",", "cn0", ",", "u0", ",", "z0", ",", "crossingTime"}], "}"}], 
     ",", 
     RowBox[{"(*", 
      RowBox[{"Hamiltonian", " ", "energy"}], "*)"}], 
     RowBox[{
      RowBox[{"energyValue", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"p0", "^", "2"}], "/", "2"}], "-", 
        RowBox[{"Cos", "[", "theta0", "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Put", " ", "the", " ", "initial", " ", "phase", " ", 
         RowBox[{"in", "[", 
          RowBox[{
           RowBox[{"-", "Pi"}], ",", "Pi"}]}]}], ")"}], "*)"}], 
      RowBox[{"thetaWrapped", "=", 
       RowBox[{
        RowBox[{"Mod", "[", 
         RowBox[{
          RowBox[{"theta0", "+", "Pi"}], ",", 
          RowBox[{"2", " ", "Pi"}]}], "]"}], "-", "Pi"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "Preserve", " ", "the", " ", "original", " ", "winding", " ", 
        "number"}], "*)"}], 
      RowBox[{"thetaShift", "=", 
       RowBox[{"theta0", "-", "thetaWrapped"}]}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"sigma", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"p0", ">=", "0"}], ",", "1", ",", 
         RowBox[{"-", "1"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Which", "[", 
       RowBox[{"(*", " ", 
        RowBox[{
        "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", 
         "===", "===", "===", "=="}], "*)"}], 
       RowBox[{"(*", 
        RowBox[{"BOUNDED", " ", 
         RowBox[{"MOTION", ":", 
          RowBox[{
           RowBox[{"-", "1"}], "<", "E", "<", "1"}]}]}], "*)"}], 
       RowBox[{"(*", " ", 
        RowBox[{
        "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", 
         "===", "===", "===", "=="}], "*)"}], 
       RowBox[{
        RowBox[{"energyValue", "<", 
         RowBox[{"1", "-", "tolerance"}]}], ",", 
        RowBox[{
         RowBox[{"k", "=", 
          RowBox[{"Sqrt", "[", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"1", "+", "energyValue"}], ")"}], "/", "2"}], "]"}]}], 
         ";", "\[IndentingNewLine]", 
         RowBox[{"sn0", "=", 
          RowBox[{
           RowBox[{"Sin", "[", 
            RowBox[{"thetaWrapped", "/", "2"}], "]"}], "/", "k"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"cn0", "=", 
          RowBox[{"p0", "/", 
           RowBox[{"(", 
            RowBox[{"2", " ", "k"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
          "Correct", " ", "elliptic", " ", "amplitude", " ", "quadrant"}], 
          "*)"}], 
         RowBox[{"u0", "=", 
          RowBox[{"ArcTan", "[", 
           RowBox[{"cn0", ",", "sn0"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"Mathematica", " ", "uses", " ", 
           RowBox[{"k", "^", "2"}], " ", "as", " ", "its", " ", "parameter"}],
           "*)"}], 
         RowBox[{"z0", "=", 
          RowBox[{"EllipticF", "[", 
           RowBox[{"u0", ",", 
            RowBox[{"k", "^", "2"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"kk", "=", "k"}], ",", 
             RowBox[{"zz0", "=", "z0"}], ",", 
             RowBox[{"shift", "=", "thetaShift"}], ",", 
             RowBox[{"e", "=", "energyValue"}], ",", 
             RowBox[{"tInitial", "=", "tau0"}]}], "}"}], ",", 
           RowBox[{"<|", 
            RowBox[{
             RowBox[{"\"\<Motion\>\"", "->", "\"\<Libration\>\""}], ",", 
             RowBox[{"\"\<Energy\>\"", "->", "e"}], ",", 
             RowBox[{"\"\<Modulus\>\"", "->", "kk"}], ",", 
             RowBox[{"\"\<Period\>\"", "->", 
              RowBox[{"4", " ", 
               RowBox[{"EllipticK", "[", 
                RowBox[{"kk", "^", "2"}], "]"}]}]}], ",", 
             RowBox[{"\"\<Theta\>\"", "->", 
              RowBox[{"Function", "[", 
               RowBox[{
                RowBox[{"{", "tau", "}"}], ",", 
                RowBox[{"shift", "+", 
                 RowBox[{"2", " ", 
                  RowBox[{"ArcSin", "[", 
                   RowBox[{"kk", " ", 
                    RowBox[{"JacobiSN", "[", 
                    RowBox[{
                    RowBox[{"zz0", "+", "tau", "-", "tInitial"}], ",", 
                    RowBox[{"kk", "^", "2"}]}], "]"}]}], "]"}]}]}]}], "]"}]}],
              ",", 
             RowBox[{"\"\<Momentum\>\"", "->", 
              RowBox[{"Function", "[", 
               RowBox[{
                RowBox[{"{", "tau", "}"}], ",", 
                RowBox[{"2", " ", "kk", " ", 
                 RowBox[{"JacobiCN", "[", 
                  RowBox[{
                   RowBox[{"zz0", "+", "tau", "-", "tInitial"}], ",", 
                   RowBox[{"kk", "^", "2"}]}], "]"}]}]}], "]"}]}]}], "|>"}]}],
           "]"}]}], ",", 
        RowBox[{"(*", " ", 
         RowBox[{
         "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
           "===", "===", "===", "=="}], "*)"}], 
        RowBox[{"(*", 
         RowBox[{"ROTATIONAL", " ", 
          RowBox[{"MOTION", ":", 
           RowBox[{"E", ">", "1"}]}]}], "*)"}], 
        RowBox[{"(*", " ", 
         RowBox[{
         "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
           "===", "===", "===", "=="}], "*)"}], 
        RowBox[{"energyValue", ">", 
         RowBox[{"1", "+", "tolerance"}]}], ",", 
        RowBox[{"(*", 
         RowBox[{"kappa", ">", 
          RowBox[{"1", " ", "is", " ", "the", " ", 
           RowBox[{"book", "'"}], "s", " ", "rotational", " ", "k"}]}], 
         "*)"}], 
        RowBox[{
         RowBox[{"kappa", "=", 
          RowBox[{"Sqrt", "[", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"energyValue", "+", "1"}], ")"}], "/", "2"}], "]"}]}], 
         ";", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{"Reciprocal", " ", "modulus"}], ",", 
           RowBox[{"less", " ", "than", " ", "one"}]}], "*)"}], 
         RowBox[{"kr", "=", 
          RowBox[{"1", "/", "kappa"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"z0", "=", 
          RowBox[{"EllipticF", "[", 
           RowBox[{
            RowBox[{"thetaWrapped", "/", "2"}], ",", 
            RowBox[{"kr", "^", "2"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"kap", "=", "kappa"}], ",", 
             RowBox[{"reciprocalK", "=", "kr"}], ",", 
             RowBox[{"zz0", "=", "z0"}], ",", 
             RowBox[{"direction", "=", "sigma"}], ",", 
             RowBox[{"shift", "=", "thetaShift"}], ",", 
             RowBox[{"e", "=", "energyValue"}], ",", 
             RowBox[{"tInitial", "=", "tau0"}]}], "}"}], ",", 
           RowBox[{"<|", 
            RowBox[{
             RowBox[{"\"\<Motion\>\"", "->", "\"\<Rotation\>\""}], ",", 
             RowBox[{"\"\<Energy\>\"", "->", "e"}], ",", 
             RowBox[{"\"\<Modulus\>\"", "->", "reciprocalK"}], ",", 
             RowBox[{"\"\<Period\>\"", "->", 
              RowBox[{"2", " ", 
               RowBox[{
                RowBox[{"EllipticK", "[", 
                 RowBox[{"reciprocalK", "^", "2"}], "]"}], "/", "kap"}]}]}], 
             ",", 
             RowBox[{"\"\<Theta\>\"", "->", 
              RowBox[{"Function", "[", 
               RowBox[{
                RowBox[{"{", "tau", "}"}], ",", 
                RowBox[{"shift", "+", 
                 RowBox[{"2", " ", 
                  RowBox[{"JacobiAmplitude", "[", 
                   RowBox[{
                    RowBox[{"zz0", "+", 
                    RowBox[{"direction", " ", "kap", " ", 
                    RowBox[{"(", 
                    RowBox[{"tau", "-", "tInitial"}], ")"}]}]}], ",", 
                    RowBox[{"reciprocalK", "^", "2"}]}], "]"}]}]}]}], "]"}]}],
              ",", 
             RowBox[{"\"\<Momentum\>\"", "->", 
              RowBox[{"Function", "[", 
               RowBox[{
                RowBox[{"{", "tau", "}"}], ",", 
                RowBox[{"2", " ", "direction", " ", "kap", " ", 
                 RowBox[{"JacobiDN", "[", 
                  RowBox[{
                   RowBox[{"zz0", "+", 
                    RowBox[{"direction", " ", "kap", " ", 
                    RowBox[{"(", 
                    RowBox[{"tau", "-", "tInitial"}], ")"}]}]}], ",", 
                   RowBox[{"reciprocalK", "^", "2"}]}], "]"}]}]}], "]"}]}]}], 
            "|>"}]}], "]"}]}], ",", 
        RowBox[{"(*", " ", 
         RowBox[{
         "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
           "===", "===", "===", "=="}], "*)"}], 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"SEPARATRIX", ":", "E"}], "=", "1"}], "*)"}], 
        RowBox[{"(*", " ", 
         RowBox[{
         "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
           "===", "===", "===", "=="}], "*)"}], "True", ",", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Abs", "[", "p0", "]"}], "<", "tolerance"}], "&&", 
           RowBox[{
            RowBox[{"Abs", "[", 
             RowBox[{
              RowBox[{"Abs", "[", "thetaWrapped", "]"}], "-", "Pi"}], "]"}], 
            "<", 
            RowBox[{"10", "^", 
             RowBox[{"-", "8"}]}]}]}], ",", 
          RowBox[{"(*", 
           RowBox[{"Unstable", " ", "fixed", " ", "point"}], "*)"}], 
          RowBox[{"With", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"thetaFixed", "=", "theta0"}], ",", 
              RowBox[{"e", "=", "energyValue"}]}], "}"}], ",", 
            RowBox[{"<|", 
             RowBox[{
              RowBox[{
              "\"\<Motion\>\"", "->", "\"\<Unstable fixed point\>\""}], ",", 
              RowBox[{"\"\<Energy\>\"", "->", "e"}], ",", 
              RowBox[{"\"\<Modulus\>\"", "->", "1"}], ",", 
              RowBox[{"\"\<Period\>\"", "->", "Infinity"}], ",", 
              RowBox[{"\"\<Theta\>\"", "->", 
               RowBox[{"Function", "[", 
                RowBox[{
                 RowBox[{"{", "tau", "}"}], ",", "thetaFixed"}], "]"}]}], ",", 
              RowBox[{"\"\<Momentum\>\"", "->", 
               RowBox[{"Function", "[", 
                RowBox[{
                 RowBox[{"{", "tau", "}"}], ",", "0"}], "]"}]}]}], "|>"}]}], 
           "]"}], ",", 
          RowBox[{"(*", 
           RowBox[{"General", " ", "separatrix", " ", "trajectory"}], "*)"}], 
          
          RowBox[{
           RowBox[{"crossingTime", "=", 
            RowBox[{"tau0", "-", 
             RowBox[{"sigma", " ", 
              RowBox[{"Log", "[", 
               RowBox[{"Tan", "[", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"Pi", "+", "thetaWrapped"}], ")"}], "/", "4"}], 
                "]"}], "]"}]}]}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"With", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"direction", "=", "sigma"}], ",", 
               RowBox[{"tc", "=", "crossingTime"}], ",", 
               RowBox[{"shift", "=", "thetaShift"}], ",", 
               RowBox[{"e", "=", "energyValue"}]}], "}"}], ",", 
             RowBox[{"<|", 
              RowBox[{
               RowBox[{"\"\<Motion\>\"", "->", "\"\<Separatrix\>\""}], ",", 
               RowBox[{"\"\<Energy\>\"", "->", "e"}], ",", 
               RowBox[{"\"\<Modulus\>\"", "->", "1"}], ",", 
               RowBox[{"\"\<Period\>\"", "->", "Infinity"}], ",", 
               RowBox[{"\"\<Theta\>\"", "->", 
                RowBox[{"Function", "[", 
                 RowBox[{
                  RowBox[{"{", "tau", "}"}], ",", 
                  RowBox[{"shift", "+", 
                   RowBox[{"4", " ", 
                    RowBox[{"ArcTan", "[", 
                    RowBox[{"Exp", "[", 
                    RowBox[{"direction", " ", 
                    RowBox[{"(", 
                    RowBox[{"tau", "-", "tc"}], ")"}]}], "]"}], "]"}]}], "-", 
                   "Pi"}]}], "]"}]}], ",", 
               RowBox[{"\"\<Momentum\>\"", "->", 
                RowBox[{"Function", "[", 
                 RowBox[{
                  RowBox[{"{", "tau", "}"}], ",", 
                  RowBox[{"2", " ", "direction", " ", 
                   RowBox[{"Sech", "[", 
                    RowBox[{"tau", "-", "tc"}], "]"}]}]}], "]"}]}]}], 
              "|>"}]}], "]"}]}]}], "]"}]}], "]"}]}]}], "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.9933279037222652`*^9, 3.993327903729335*^9}},
 CellLabel->"In[38]:=",ExpressionUUID->"922fad09-a98c-4cc4-849d-97eab8e5cfa1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "solution", ",", "energyValue", ",", "motionType", ",", 
       "characteristicTime", ",", "timeMaximum", ",", "timePlot", ",", 
       "phasePlot", ",", "separatrixPlot"}], "}"}], ",", 
     RowBox[{
      RowBox[{"solution", "=", 
       RowBox[{"pendulumSolution", "[", 
        RowBox[{"theta0", ",", "p0"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"energyValue", "=", 
       RowBox[{"solution", "[", "\"\<Energy\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"motionType", "=", 
       RowBox[{"solution", "[", "\"\<Motion\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"characteristicTime", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"NumericQ", "[", 
           RowBox[{"solution", "[", "\"\<Period\>\"", "]"}], "]"}], "&&", 
          RowBox[{
           RowBox[{"solution", "[", "\"\<Period\>\"", "]"}], "=!=", 
           "Infinity"}]}], ",", 
         RowBox[{"solution", "[", "\"\<Period\>\"", "]"}], ",", "10"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"timeMaximum", "=", 
       RowBox[{"nPeriods", " ", "characteristicTime"}]}], ";", 
