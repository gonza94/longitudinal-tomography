Cell[BoxData[
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "es", ",", "k", ",", "period", ",", "timePlot", ",", "phasePlot", ",", 
       "separatrix"}], "}"}], ",", 
     RowBox[{
      RowBox[{"es", "=", 
       RowBox[{"energy", "[", 
        RowBox[{"theta0", ",", "p0"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Which", "[", 
       RowBox[{"(*", 
        RowBox[{"Exact", " ", "stable", " ", "fixed", " ", "point"}], "*)"}], 
       
       RowBox[{
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{"es", "+", "1"}], "]"}], "<", 
         RowBox[{"10", "^", 
          RowBox[{"-", "10"}]}]}], ",", 
        RowBox[{"Column", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Style", "[", 
            RowBox[{
            "\"\<Stable fixed point: \[Theta](\[Tau]) = 0 and P(\[Tau]) = 0\>\
\"", ",", "14"}], "]"}], ",", 
           RowBox[{"Graphics", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"PointSize", "[", "0.025", "]"}], ",", 
               RowBox[{"Point", "[", 
                RowBox[{"{", 
                 RowBox[{"0", ",", "0"}], "}"}], "]"}]}], "}"}], ",", 
             RowBox[{"Frame", "->", "True"}], ",", 
             RowBox[{"FrameLabel", "->", 
              RowBox[{"{", 
               RowBox[{"\"\<\[Theta]\>\"", ",", "\"\<P\>\""}], "}"}]}], ",", 
             RowBox[{"PlotRange", "->", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"-", "Pi"}], ",", "Pi"}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"-", "2.2"}], ",", "2.2"}], "}"}]}], "}"}]}], ",", 
             RowBox[{"AspectRatio", "->", "1"}], ",", 
             RowBox[{"ImageSize", "->", "Large"}]}], "]"}]}], "}"}], "]"}], 
        ",", 
        RowBox[{"(*", 
         RowBox[{"Librational", " ", "motion"}], "*)"}], 
        RowBox[{
         RowBox[{"-", "1"}], "<", "es", "<", "1"}], ",", 
        RowBox[{
         RowBox[{"k", "=", 
          RowBox[{"Sqrt", "[", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"1", "+", "es"}], ")"}], "/", "2"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"period", "=", 
          RowBox[{"4", " ", 
           RowBox[{"EllipticK", "[", 
            RowBox[{"k", "^", "2"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"timePlot", "=", 
          RowBox[{"Plot", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"thetaExact", "[", 
               RowBox[{"tau", ",", "theta0", ",", "p0"}], "]"}], ",", 
              RowBox[{"pExact", "[", 
               RowBox[{"tau", ",", "theta0", ",", "p0"}], "]"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"tau", ",", "0", ",", 
              RowBox[{"nPeriods", " ", "period"}]}], "}"}], ",", 
            RowBox[{"Frame", "->", "True"}], ",", 
            RowBox[{"FrameLabel", "->", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Style", "[", 
                RowBox[{"\"\<\[Tau]\>\"", ",", "14"}], "]"}], ",", 
               RowBox[{"Style", "[", 
                RowBox[{"\"\<\[Theta](\[Tau]), P(\[Tau])\>\"", ",", "14"}], 
                "]"}]}], "}"}]}], ",", 
            RowBox[{"PlotLegends", "->", 
             RowBox[{"{", 
              RowBox[{"\"\<\[Theta](\[Tau])\>\"", ",", "\"\<P(\[Tau])\>\""}], 
              "}"}]}], ",", 
            RowBox[{"PlotRange", "->", "All"}], ",", 
            RowBox[{"ImageSize", "->", "Large"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"separatrix", "=", 
          RowBox[{"Plot", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"2", " ", 
               RowBox[{"Cos", "[", 
                RowBox[{"theta", "/", "2"}], "]"}]}], ",", 
              RowBox[{
               RowBox[{"-", "2"}], " ", 
               RowBox[{"Cos", "[", 
                RowBox[{"theta", "/", "2"}], "]"}]}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"theta", ",", 
              RowBox[{"-", "Pi"}], ",", "Pi"}], "}"}], ",", 
            RowBox[{"PlotStyle", "->", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Directive", "[", 
                RowBox[{"Gray", ",", "Dashed"}], "]"}], ",", 
               RowBox[{"Directive", "[", 
                RowBox[{"Gray", ",", "Dashed"}], "]"}]}], "}"}]}]}], "]"}]}], 
         ";", "\[IndentingNewLine]", 
         RowBox[{"phasePlot", "=", 
          RowBox[{"Show", "[", 
           RowBox[{"separatrix", ",", 
            RowBox[{"ParametricPlot", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"thetaExact", "[", 
                 RowBox[{"tau", ",", "theta0", ",", "p0"}], "]"}], ",", 
                RowBox[{"pExact", "[", 
                 RowBox[{"tau", ",", "theta0", ",", "p0"}], "]"}]}], "}"}], 
              ",", 
              RowBox[{"{", 
               RowBox[{"tau", ",", "0", ",", "period"}], "}"}], ",", 
              RowBox[{"PlotStyle", "->", "Thick"}]}], "]"}], ",", 
            RowBox[{"Graphics", "[", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"PointSize", "[", "0.022", "]"}], ",", 
               RowBox[{"Point", "[", 
                RowBox[{"{", 
                 RowBox[{"theta0", ",", "p0"}], "}"}], "]"}]}], "}"}], "]"}], 
            ",", 
            RowBox[{"Frame", "->", "True"}], ",", 
            RowBox[{"FrameLabel", "->", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Style", "[", 
                RowBox[{"\"\<\[Theta]\>\"", ",", "14"}], "]"}], ",", 
               RowBox[{"Style", "[", 
                RowBox[{"\"\<P\>\"", ",", "14"}], "]"}]}], "}"}]}], ",", 
            RowBox[{"PlotRange", "->", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"-", "Pi"}], ",", "Pi"}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"-", "2.2"}], ",", "2.2"}], "}"}]}], "}"}]}], ",", 
            RowBox[{"AspectRatio", "->", "1"}], ",", 
            RowBox[{"ImageSize", "->", "Large"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Column", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Grid", "[", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"Style", "[", 
                  RowBox[{"\"\<Energy\>\"", ",", "Bold"}], "]"}], ",", 
                 RowBox[{"NumberForm", "[", 
                  RowBox[{"es", ",", 
                   RowBox[{"{", 
                    RowBox[{"7", ",", "4"}], "}"}]}], "]"}], ",", 
                 RowBox[{"Spacer", "[", "20", "]"}], ",", 
                 RowBox[{"Style", "[", 
                  RowBox[{"\"\<Modulus k\>\"", ",", "Bold"}], "]"}], ",", 
                 RowBox[{"NumberForm", "[", 
                  RowBox[{"k", ",", 
                   RowBox[{"{", 
                    RowBox[{"7", ",", "4"}], "}"}]}], "]"}]}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"Style", "[", 
                  RowBox[{"\"\<Period\>\"", ",", "Bold"}], "]"}], ",", 
                 RowBox[{"NumberForm", "[", 
                  RowBox[{"period", ",", 
                   RowBox[{"{", 
                    RowBox[{"8", ",", "4"}], "}"}]}], "]"}], ",", 
                 RowBox[{"Spacer", "[", "20", "]"}], ",", 
                 RowBox[{"Style", "[", 
                  RowBox[{"\"\<Motion\>\"", ",", "Bold"}], "]"}], ",", 
                 "\"\<Libration\>\""}], "}"}]}], "}"}], "]"}], ",", 
            "timePlot", ",", "phasePlot"}], "}"}], "]"}]}], ",", 
        RowBox[{"(*", 
         RowBox[{"Separatrix", " ", "or", " ", "rotational", " ", "region"}], 
         "*)"}], "True", ",", 
        RowBox[{"Style", "[", 
         RowBox[{
          RowBox[{"Column", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Row", "[", 
              RowBox[{"{", 
               RowBox[{
               "\"\<The selected initial conditions give E = \>\"", ",", 
                RowBox[{"NumberForm", "[", 
                 RowBox[{"es", ",", 
                  RowBox[{"{", 
                   RowBox[{"7", ",", "4"}], "}"}]}], "]"}], ",", 
                "\"\<.\>\""}], "}"}], "]"}], ",", 
             "\"\<The librational solution requires -1 < E < 1.\>\"", ",", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Abs", "[", 
                 RowBox[{"es", "-", "1"}], "]"}], "<", 
                RowBox[{"10", "^", 
                 RowBox[{"-", "6"}]}]}], ",", 
               "\"\<The point is on the separatrix.\>\"", ",", 
               "\"\<These initial conditions correspond to rotational motion.\
\>\""}], "]"}]}], "}"}], "]"}], ",", "Red", ",", "14"}], "]"}]}], "]"}]}]}], 
