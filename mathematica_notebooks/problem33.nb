      RowBox[{"z", "=", 
       RowBox[{
        RowBox[{"z0", "[", 
         RowBox[{"theta0", ",", "p0"}], "]"}], "+", 
        RowBox[{"sigma", " ", "tau"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"2", " ", "sigma", " ", "k", " ", 
       RowBox[{"JacobiCN", "[", 
        RowBox[{"z", ",", 
         RowBox[{"k", "^", "2"}]}], "]"}]}]}]}], "]"}]}], ";"}]], "Input",
