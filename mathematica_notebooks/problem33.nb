Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "energy", ",", "kModulus", ",", "u0", ",", "sigma0", ",", "z0", ",", 
     "thetaExact", ",", "pExact", ",", "theta0Value", ",", "p0Value", ",", 
     "eValue", ",", "kValue", ",", "periodValue"}], "]"}], ";"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{"Energy", " ", "from", " ", "initial", " ", "conditions"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"energy", "[", 
     RowBox[{
      RowBox[{"theta0_", "?", "NumericQ"}], ",", 
      RowBox[{"p0_", "?", "NumericQ"}]}], "]"}], ":=", 
    RowBox[{
     RowBox[{
      RowBox[{"p0", "^", "2"}], "/", "2"}], "-", 
     RowBox[{"Cos", "[", "theta0", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
  "\n", 
  RowBox[{"(*", 
   RowBox[{"Elliptic", " ", "modulus", " ", "k"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"kModulus", "[", 
     RowBox[{
      RowBox[{"theta0_", "?", "NumericQ"}], ",", 
      RowBox[{"p0_", "?", "NumericQ"}]}], "]"}], ":=", 
    RowBox[{"Sqrt", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{"energy", "[", 
         RowBox[{"theta0", ",", "p0"}], "]"}]}], ")"}], "/", "2"}], "]"}]}], 
   ";"}], "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{"Initial", " ", "elliptic", " ", "amplitude"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"u0", "[", 
     RowBox[{
      RowBox[{"theta0_", "?", "NumericQ"}], ",", 
      RowBox[{"p0_", "?", "NumericQ"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "k", "}"}], ",", 
      RowBox[{
       RowBox[{"k", "=", 
        RowBox[{"kModulus", "[", 
         RowBox[{"theta0", ",", "p0"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"ArcSin", "[", 
        RowBox[{
         RowBox[{"Sin", "[", 
          RowBox[{"theta0", "/", "2"}], "]"}], "/", "k"}], "]"}]}]}], "]"}]}],
    ";"}], "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{"Initial", " ", "direction", " ", "of", " ", "motion"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"sigma0", "[", 
     RowBox[{"p0_", "?", "NumericQ"}], "]"}], ":=", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"p0", ">=", "0"}], ",", "1", ",", 
      RowBox[{"-", "1"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{"Initial", " ", "Jacobi", " ", "argument"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"z0", "[", 
    RowBox[{
     RowBox[{"theta0_", "?", "NumericQ"}], ",", 
     RowBox[{"p0_", "?", "NumericQ"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "k", "}"}], ",", 
     RowBox[{
      RowBox[{"k", "=", 
       RowBox[{"kModulus", "[", 
        RowBox[{"theta0", ",", "p0"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"EllipticF", "[", 
       RowBox[{
        RowBox[{"u0", "[", 
         RowBox[{"theta0", ",", "p0"}], "]"}], ",", 
        RowBox[{"k", "^", "2"}]}], "]"}]}]}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9933266174676437`*^9, 3.993326617473341*^9}},
 CellLabel->"In[15]:=",ExpressionUUID->"ac361c73-5b71-4baa-a61d-d66370b247f5"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"thetaExact", "[", 
    RowBox[{
     RowBox[{"tau_", "?", "NumericQ"}], ",", 
     RowBox[{"theta0_", "?", "NumericQ"}], ",", 
     RowBox[{"p0_", "?", "NumericQ"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"k", ",", "z", ",", "sigma"}], "}"}], ",", 
     RowBox[{
      RowBox[{"k", "=", 
       RowBox[{"kModulus", "[", 
        RowBox[{"theta0", ",", "p0"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"sigma", "=", 
       RowBox[{"sigma0", "[", "p0", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"z", "=", 
       RowBox[{
        RowBox[{"z0", "[", 
         RowBox[{"theta0", ",", "p0"}], "]"}], "+", 
        RowBox[{"sigma", " ", "tau"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"2", " ", 
       RowBox[{"ArcSin", "[", 
        RowBox[{"k", " ", 
         RowBox[{"JacobiSN", "[", 
          RowBox[{"z", ",", 
           RowBox[{"k", "^", "2"}]}], "]"}]}], "]"}]}]}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.993326632981475*^9, 3.9933266329870567`*^9}},
 CellLabel->"In[21]:=",ExpressionUUID->"3d4c405b-6025-4394-90c1-de5bf9886241"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"pExact", "[", 
    RowBox[{
     RowBox[{"tau_", "?", "NumericQ"}], ",", 
     RowBox[{"theta0_", "?", "NumericQ"}], ",", 
     RowBox[{"p0_", "?", "NumericQ"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"k", ",", "z", ",", "sigma"}], "}"}], ",", 
     RowBox[{
      RowBox[{"k", "=", 
       RowBox[{"kModulus", "[", 
