          Clip[Sin[$CellContext`theta0/2]/$CellContext`k, {-1, 
            1}]; $CellContext`cn0 = 
          Clip[$CellContext`p0/(2 $CellContext`k), {-1, 1}]; $CellContext`u0 = 
          ArcTan[$CellContext`cn0, $CellContext`sn0]; 
         EllipticF[$CellContext`u0, $CellContext`k^2]], $CellContext`pExact[
